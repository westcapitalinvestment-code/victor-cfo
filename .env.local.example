NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   (solo servidor, nunca exponer al cliente)

# VICTOR (chat con Claude) — platform.claude.com
ANTHROPIC_API_KEY=

# Invitar al contable — resend.com (opcional; sin esto, la invitación se
# guarda igual pero no se manda el correo automático)
RESEND_API_KEY=
# RESEND_FROM_EMAIL="VICTOR <notificaciones@tudominio.com>"   (requiere dominio verificado en Resend; sin esto usa el dominio de pruebas de Resend)

# Conectar banco (Plaid) — dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
# PLAID_ENV=sandbox   (sandbox | development | production — por defecto sandbox si no se pone nada)

# Llave de cifrado para el access_token de Plaid antes de guardarlo en
# Supabase (obligatoria — sin esto, conectar un banco falla a propósito).
# Genera una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guárdala en un lugar seguro (gestor de contraseñas) además de aquí — si
# se pierde, los bancos ya conectados quedan inservibles y hay que
# reconectarlos todos de cero.
PLAID_TOKEN_ENCRYPTION_KEY=

# Secreto que Vercel manda en el header "Authorization: Bearer <esto>" al
# invocar los Cron Jobs (ver vercel.json) — cualquier valor largo y
# aleatorio sirve, ej.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Notificaciones push (documentos por vencer, gastos sin categorizar) —
# llaves VAPID, un par fijo por proyecto (NO por usuario). Se generan UNA
# sola vez con:
#   npx web-push generate-vapid-keys
# La pública lleva NEXT_PUBLIC_ porque el navegador la necesita para
# suscribirse; la privada nunca sale del servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:tucorreo@dominio.com"   (opcional — identifica quién manda el push; por defecto usa un correo genérico)

# Stripe (cobro real) — dashboard.stripe.com
# La Secret Key empieza con sk_test_ (modo prueba) o sk_live_ (modo real) —
# NUNCA la Publishable Key (pk_...), esa es para el navegador y aquí no se usa.
STRIPE_SECRET_KEY=
# Se genera cuando conectas el endpoint del webhook (Developers → Webhooks
# → Add endpoint → URL: https://www.victorcfo.com/api/stripe/webhook →
# eventos: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid). Empieza con whsec_.
STRIPE_WEBHOOK_SECRET=

# Los 6 Price IDs (3 planes x 2 ciclos) — cada uno se crea en Stripe
# Dashboard → Products → tu producto → "Add another price". Empiezan con
# price_. Los montos en Stripe son inmutables: si algún día cambia un
# precio, se crea un Price nuevo y se archiva el viejo, nunca se edita.
STRIPE_PRICE_CORE_MENSUAL=
STRIPE_PRICE_CORE_ANUAL=
STRIPE_PRICE_PRO_MENSUAL=
STRIPE_PRICE_PRO_ANUAL=
# Pro+ ya no es autoservicio (es Enterprise, bloqueado) — el código todavía
# los soporta pero no hace falta crearlos ni llenar estas dos.
STRIPE_PRICE_PROPLUS_MENSUAL=
STRIPE_PRICE_PROPLUS_ANUAL=

# Precio de referido de Core — mismo producto Core, un segundo Price a
# $12.99/mes (y opcionalmente $142/año como equivalente anual) — solo se
# usa cuando el que paga fue referido por otro usuario. Pro no necesita
# esto: en vez de un precio aparte usa un trial de 30 días sobre el mismo
# Price ID de Pro (ver app/api/stripe/checkout/route.ts).
STRIPE_PRICE_CORE_MENSUAL_REFERIDO=
STRIPE_PRICE_CORE_ANUAL_REFERIDO=

# Addon Equipo (técnicos) — $20/mes, hasta 3 técnicos. Se añade como un
# SEGUNDO subscription item sobre la suscripción Pro existente (no es un
# plan aparte). Crear en Stripe Dashboard → el mismo producto de Pro (o
# uno nuevo "Addon Equipo") → Add another price → recurring $20/mes.
STRIPE_PRICE_ADDON_TECNICOS=
# Addon Admin/Secretaria — cobro POR SEAT (cantidad = seats activos +
# invitaciones pendientes). Secretaria $10/mes/seat, Administrador
# $20/mes/seat — dos Price IDs y dos subscription items independientes.
STRIPE_PRICE_ADDON_SECRE=
STRIPE_PRICE_ADDON_ADMINISTRADOR=
# Addon Entidad adicional — $24.99/mes POR SEAT (cantidad = entidades de
# negocio activas menos 1, la primera va incluida en Pro).
STRIPE_PRICE_ADDON_ENTIDAD=

# Cloudflare R2 (archivos de la Bóveda: fotos/PDFs de pólizas, permisos,
# contratos, licencias) — dash.cloudflare.com → R2 Object Storage.
# 1. Crea un bucket (ej. "victor-cfo-boveda"), déjalo PRIVADO (no público).
# 2. R2_ACCOUNT_ID: lo ves en la URL del dashboard de Cloudflare
#    (dash.cloudflare.com/<ACCOUNT_ID>/r2) o en R2 → Overview, a la derecha.
# 3. R2 → Manage API Tokens → Create API Token → permisos "Object Read &
#    Write", limitado a ese bucket → te da Access Key ID y Secret Access Key
#    (el Secret solo se muestra una vez, cópialo de inmediato).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# PIN de bloqueo rápido de la app (opcional). Pepper fijo del servidor para
# el hash del PIN de 4 dígitos (ver lib/pin.ts) — si no lo pones, usa un
# valor por defecto embebido en el código, así que esto NO es obligatorio
# para que la función funcione, pero sí recomendado en producción. Genera
# uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PIN_PEPPER=

# Sesión del técnico (opcional, módulo Equipo) — igual que PIN_PEPPER: firma
# el cookie de sesión del técnico (ver lib/tecnico-session.ts). Sin esto usa
# un valor por defecto embebido, no es obligatorio pero sí recomendado en
# producción. Genera uno con el mismo comando de arriba.
TECNICO_SESSION_SECRET=